(diagram (500 120)
  (grid)
  (with-options (:fill :lightcyan :stroke :navy)
    (let ((cc canvas.cc))
      (labels ((label (txt)
                 (text (y+ $1.cc 5) txt :align :center :font 10)))
      (regular-polygon (x+ cc -180) 4 50 :debug t)
      (label ":debug t")
      (regular-polygon (x+ cc  -60) 4 50 :debug t :tilt 45)
      (label ":tilt 45")
      (regular-polygon (x+ cc   60) 4 50 :debug t :tilt 45 :offsets '((10 15) (10 -15)))
      (label ":offsets (...)")
      (regular-polygon (x+ cc  180) 4 50 :debug t :tilt 45 :offsets '((10 15) (10 -15)) :rotate -35)
      (label ":rotate -35")))))
